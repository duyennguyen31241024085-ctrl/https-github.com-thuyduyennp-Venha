@model Genre
@{ ViewData["Title"] = "Thêm thể loại"; }
<section class="panel form-panel">
    <h1>Thêm thể loại</h1>
    <form asp-action="Create" asp-route-id="@(Model.ID == 0 ? null : Model.ID)" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="field"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="row-actions"><button class="btn btn-accent">Lưu thể loại</button><a asp-action="Index">Hủy</a></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
