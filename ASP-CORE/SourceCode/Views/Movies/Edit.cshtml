@model Movie
@{ ViewData["Title"] = "Chỉnh sửa phim"; }
<section class="panel form-panel">
    <h1>Chỉnh sửa phim</h1>
    <form asp-action="Edit" asp-route-id="@(Model.ID == 0 ? null : Model.ID)" method="post" enctype="multipart/form-data">
        <partial name="_Form" model="Model" />
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
