@model IReadOnlyList<CartLine>
@{ ViewData["Title"] = "Giỏ hàng"; }
<h1>Giỏ hàng</h1>
@if (Model.Count == 0)
{
    <section class="panel"><p>Giỏ hàng của bạn đang trống.</p><a class="btn btn-accent" asp-action="Index">Về kho phim</a></section>
}
else
{
    <div class="panel table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Phim</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead>
            <tbody>
            @foreach (var line in Model)
            {
                <tr>
                    <th scope="row"><a asp-action="Details" asp-route-id="@line.Movie.ID">@line.Movie.Title</a></th>
                    <td>@line.Movie.Price.ToString("N0") ₫</td>
                    <td>
                        <form class="row-actions quantity" asp-action="UpdateCart" asp-route-id="@line.Movie.ID" method="post">
                            <input aria-label="Số lượng @line.Movie.Title" class="form-control" name="quantity" type="number" min="1" max="99" value="@line.Quantity" required />
                            <button class="btn btn-small">Cập nhật</button>
                        </form>
                    </td>
                    <td>@line.Total.ToString("N0") ₫</td>
                    <td><form asp-action="RemoveFromCart" asp-route-id="@line.Movie.ID" method="post"><button class="btn btn-outline-danger btn-sm">Xóa</button></form></td>
                </tr>
            }
            </tbody>
            <tfoot><tr><th colspan="3">Tổng tiền</th><td colspan="2"><strong>@Model.Sum(line => line.Total).ToString("N0") ₫</strong></td></tr></tfoot>
        </table>
        <div class="row-actions"><a class="btn btn-accent" asp-action="Checkout">Thanh toán</a><a asp-action="Index">Tiếp tục mua</a></div>
    </div>
}
