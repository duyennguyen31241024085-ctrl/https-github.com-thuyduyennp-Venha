@model Movie
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="field"><label asp-for="Title"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
<div class="field"><label asp-for="Summary"></label><textarea asp-for="Summary" class="form-control" rows="3"></textarea><span asp-validation-for="Summary" class="text-danger"></span></div>
<div class="field-pair">
    <div class="field"><label asp-for="ReleaseDate"></label><input asp-for="ReleaseDate" class="form-control" /><span asp-validation-for="ReleaseDate" class="text-danger"></span></div>
    <div class="field"><label asp-for="GenreID"></label><select asp-for="GenreID" asp-items="ViewBag.Genres" class="form-select"><option value="">Chọn thể loại</option></select><span asp-validation-for="GenreID" class="text-danger"></span></div>
    <div class="field"><label asp-for="Price"></label><input asp-for="Price" type="number" min="5000" step="0.01" class="form-control" /><span asp-validation-for="Price" class="text-danger"></span></div>
    <div class="field"><label asp-for="Rated"></label><input asp-for="Rated" type="number" min="1" max="5" step="0.1" class="form-control" /><span asp-validation-for="Rated" class="text-danger"></span></div>
</div>
<div class="field">
    <label asp-for="PictureUpload"></label><input asp-for="PictureUpload" type="file" accept=".jpg,.jpeg,.png" class="form-control" />
    <small>JPEG hoặc PNG, tối đa 5 MB.</small><span asp-validation-for="PictureUpload" class="text-danger"></span>
</div>
@if (!string.IsNullOrEmpty(Model.PicturePath))
{
    <img class="edit-preview" src="@Model.PicturePath" alt="Ảnh bìa hiện tại" />
}
<div class="row-actions"><button class="btn btn-accent">Lưu phim</button><a asp-action="Index">Hủy</a></div>
